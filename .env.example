# Copiar a .env (que está en .gitignore):  cp .env.example .env
# Credenciales solo para la base local de desarrollo; los puertos se publican en 127.0.0.1.

POSTGRES_USER=sinac
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=sinac

# Puerto del host para Postgres; scripts/ se conecta a localhost:POSTGRES_PORT.
# Si ya tenés un Postgres instalado en 5432, usá otro (por ejemplo 5433).
POSTGRES_PORT=5432

# Puerto del host para Adminer (solo con --profile dev).
ADMINER_PORT=8080
