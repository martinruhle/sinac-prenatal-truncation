# Copy to .env (which is in .gitignore):  cp .env.example .env
# Credentials for the local development database only; ports are published on 127.0.0.1.

POSTGRES_USER=sinac
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=sinac

# Host port for Postgres; scripts/ connects to localhost:POSTGRES_PORT.
# If you already have a Postgres installed on 5432, use another one (for example 5433).
POSTGRES_PORT=5432

# Host port for Adminer (only with --profile dev).
ADMINER_PORT=8080
