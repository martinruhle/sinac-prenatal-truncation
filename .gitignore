# Data and secrets: never in git
/data/
.env
.env.*
!.env.example

# Archive and columnar files, wherever they are written: the records live under /data/ only
*.zip
*.7z
*.gz
*.rar
*.parquet
*.feather
*.dta
*.sav
*.xlsx

# Local worktrees of a coding assistant, each with its own .env and data/
.claude/worktrees/

# Python environment
.venv/
__pycache__/

# Tool caches and reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local context, not versioned
CLAUDE.local.md
/.planning/
