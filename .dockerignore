# An allowlist: everything stays out of the build context except what the analysis image needs
# (rule 1, D-131). A path not listed here never reaches Docker, so data/, .env, .venv/,
# .planning/ and any copy of the repository under .claude/ stay out, at any depth.
*

# Dependencies and project metadata (pyproject.toml names README.md as the package readme)
!pyproject.toml
!uv.lock
!.python-version
!README.md

# Code, SQL, configuration and the synthetic tests
!src/
!scripts/
!sql/
!config/
!tests/

# Re-excluded inside the allowed folders
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.pyc
